{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.3",
  "description": "DeepSeek Harness 桌面版：自包含的 DSH Web GUI，支持自动更新",
  "main": "src/main.js",
  "author": "admin",
  "license": "MIT",
  "scripts": {
    "runtime": "node scripts/prepare-runtime.mjs",
    "icon": "node scripts/gen-icon.mjs",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always",
    "serve:feed": "node scripts/serve-local-feed.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DSH Desktop",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources", "to": ".", "filter": ["node/**/*", "dsh/**/*"] }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DSH-Desktop-${version}-setup.${ext}",
      "shortcutName": "DSH Desktop",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "dsh-desktop"
    }
  }
}
